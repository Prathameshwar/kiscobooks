{
  "$defs": {
    "GstTaxComponent": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "decimal_places": 4,
          "gt": 0,
          "max_digits": 19,
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Amount",
          "type": "string"
        },
        "code": {
          "enum": [
            "CGST",
            "SGST",
            "UTGST",
            "IGST",
            "CESS"
          ],
          "title": "Code",
          "type": "string"
        }
      },
      "required": [
        "code",
        "amount"
      ],
      "title": "GstTaxComponent",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Version-two Catalog statement: names the company registration the supply is made\nunder, so Accounting can apply the regime valid on ``posting_date``. The key is\nrequired (null only for an untaxed statement) so the signed body is unambiguous.",
  "properties": {
    "assessment_id": {
      "format": "uuid",
      "title": "Assessment Id",
      "type": "string"
    },
    "company_id": {
      "format": "uuid",
      "title": "Company Id",
      "type": "string"
    },
    "company_registration_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Company Registration Id"
    },
    "components": {
      "items": {
        "$ref": "#/$defs/GstTaxComponent"
      },
      "maxItems": 5,
      "title": "Components",
      "type": "array"
    },
    "currency": {
      "pattern": "^[A-Z]{3}$",
      "title": "Currency",
      "type": "string"
    },
    "gross_amount": {
      "decimal_places": 4,
      "gt": 0,
      "max_digits": 19,
      "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
      "title": "Gross Amount",
      "type": "string"
    },
    "input_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Hash",
      "type": "string"
    },
    "net_amount": {
      "decimal_places": 4,
      "gt": 0,
      "max_digits": 19,
      "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
      "title": "Net Amount",
      "type": "string"
    },
    "posting_date": {
      "format": "date",
      "title": "Posting Date",
      "type": "string"
    },
    "provider_id": {
      "format": "uuid",
      "title": "Provider Id",
      "type": "string"
    },
    "tenant_id": {
      "format": "uuid",
      "title": "Tenant Id",
      "type": "string"
    },
    "version": {
      "const": 2,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "version",
    "provider_id",
    "tenant_id",
    "company_id",
    "assessment_id",
    "company_registration_id",
    "input_hash",
    "posting_date",
    "currency",
    "net_amount",
    "gross_amount",
    "components"
  ],
  "title": "TaxComputationV2",
  "type": "object"
}
