{
  "name": "janso-mfes",
  "version": "0.1.0",
  "private": true,
  "description": "KiscoBooks web micro-frontends and the shared design system.",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:auth": "pnpm --filter @janso/auth dev",
    "dev:console": "pnpm --filter @janso/console dev",
    "build:auth": "pnpm --filter @janso/auth build",
    "build:console": "pnpm --filter @janso/console build",
    "test": "pnpm -r test",
    "test:ui": "pnpm --filter @janso/ui test",
    "test:auth": "pnpm --filter @janso/auth test",
    "test:console": "pnpm --filter @janso/console test",
    "typecheck": "pnpm -r typecheck"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=20"
  }
}
