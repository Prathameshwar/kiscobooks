proxy_set_header Host              $host;
proxy_set_header X-Real-IP         $remote_addr;
proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_set_header X-Trace-Id        $bill_trace_id;
proxy_http_version 1.1;
proxy_set_header Connection "";
# proxy_buffering is left at nginx's default (on). Setting it here would make
# it a duplicate directive in any location that needs it off for streaming,
# which nginx rejects at config-load time.
